{
  "name": "assetto-roadbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:ui": "vitest run tests/editor.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.5"
  }
}
